# Cycle Ella — backend environment variables
# Copy this file to backend/.env and fill in the values.
# .env is gitignored and must never be committed.

# Server
PORT=

# MySQL database (DB_HOST, DB_USER and DB_NAME are required — the server
# refuses to start without them)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret used to sign JWTs (required — the server refuses to start without
# it). Use a long random string; changing it invalidates existing logins.
JWT_SECRET=

# OpenWeatherMap API key, used by the daily weather tip
WEATHER_API_KEY=

# Google Gemini API key, used by the chatbot
GEMINI_API_KEY=

# Admin dashboard login (/dashboard). ADMIN_PASSWORD_HASH is a bcrypt hash,
# never a plain-text password — generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
